{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=ecf_dgii;Username=postgres;Password=postgres",
    "Redis": "localhost:6379"
  },
  "JwtSettings": {
    "_comment": "Secret is intentionally not set here. Non-Development environments fail to start without a real value (see Program.cs's fail-fast checks) — set it via User Secrets locally, or an environment variable / secret store in any real deployment. Never commit a real value.",
    "Secret": "",
    "ExpirationMinutes": 60,
    "Issuer": "EcfDgiiClientIssuer",
    "Audience": "EcfDgiiClientAudience"
  },
  "_workerSecretKeyComment": "WorkerSecretKey (flat key, read by ConfigurationWorkerKeyResolver) is intentionally not set here — same rule as JwtSettings:Secret above. WORKER_SECRET_KEY as an env var works too.",
  "WorkerSecretKey": "",
  "WorkerKeyId": "default-worker-id",
  "EcfEmisor": {
    "Rnc": "101672919"
  },
  "EcfClientOptions": {
    "ApiKey": "",
    "BaseUrl": "",
    "Environment": "Test",
    "Mode": "DgiiDirect",
    "RncEmisor": "101672919",
    "CertificatePath": "",
    "CertificatePassword": "",
    "AutoRetryOnReuseableSequence": true
  }
}
