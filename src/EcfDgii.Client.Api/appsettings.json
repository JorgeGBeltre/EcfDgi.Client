{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=ecf_dgii;Username=postgres;Password=postgres",
    "Redis": "localhost:6379"
  },
  "JwtSettings": {
    "Secret": "",
    "ExpirationMinutes": 60,
    "Issuer": "EcfDgiiClientIssuer",
    "Audience": "EcfDgiiClientAudience"
  },
  "WorkerSecretKey": "",
  "WorkerKeyId": "default-worker-id",
  "EcfEmisor": {
    "Rnc": "",
    "RazonSocial": "EMPRESA DEMO SRL"
  },
  "EcfClientOptions": {
    "ApiKey": "",
    "BaseUrl": "",
    "Environment": "Test",
    "Mode": "DgiiDirect",
    "RncEmisor": "",
    "CertificatePath": "",
    "CertificatePassword": "",
    "AutoRetryOnReuseableSequence": true
  },
  "EcfStatusPolling": {
    "PollingIntervalSeconds": 60,
    "MinDocumentAgeMinutes": 2,
    "MaxPollingWindowHours": 72,
    "BatchSize": 50
  }
}
